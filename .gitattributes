# Default: enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly set LF for common file types
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
dockerfile text eol=lf
Dockerfile text eol=lf
